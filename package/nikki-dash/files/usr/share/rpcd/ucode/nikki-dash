	delete_profile: {
		args: { name: '', fallback_profile: '', force_stop: false },
		call: function(req) {
			let name = req.args?.name;
			let rp = resolve_safe_path('profile', name, true);
			if (!rp.ok) return rp;
			if (!rp.exists) return err_res('NOT_FOUND', 'Profile file does not exist');

			let lock = acquire_lock('delete_profile', 30);
			if (!lock.ok) return err_res('LOCKED', lock.error);

			let uci = cursor();
			let active = uci.get('nikki', 'config', 'profile') ?? '';
			if (active == `file:${name}`) {
				if (req.args?.fallback_profile && length(req.args.fallback_profile) > 0) {
					uci.set('nikki', 'config', 'profile', req.args.fallback_profile);
					uci.commit('nikki');
				} else if (req.args?.force_stop) {
					uci.set('nikki', 'config', 'enabled', '0');
					uci.delete('nikki', 'config', 'profile');
					uci.commit('nikki');
					exec_argv(['/etc/init.d/nikki', 'stop']);
				} else {
					release_lock();
					return err_res('ACTIVE_PROFILE_PROTECTED', 'Cannot delete active profile without switching to another profile or stopping Nikki');
				}
			}

			unlink(rp.path);
			release_lock();
			return ok_res({ deleted: name, revision: compute_config_revision() });
		}
	},

	save_subscription: {
		args: { id: '', name: '', url: '', info_url: '', user_agent: '', prefer: '', revision: '' },
		call: function(req) {
			let name = trim(req.args?.name ?? '');
			let url = trim(req.args?.url ?? '');
			let info_url = trim(req.args?.info_url ?? '');
			let ua = trim(req.args?.user_agent ?? 'clash');
			let prefer = req.args?.prefer ?? 'remote';

			if (length(name) == 0 || length(name) > 128 || (index(name, chr(0)) >= 0 || match(name, /[\r\n]/))) {
				return err_res('INVALID_PARAM', 'Subscription name is required');
			}
			if (!is_safe_url(url)) {
				return err_res('INVALID_PARAM', 'Subscription URL must be a valid http(s) URL');
			}
			if (length(info_url) > 0 && !is_safe_url(info_url)) {
				return err_res('INVALID_PARAM', 'Subscription Info URL must be a valid http(s) URL');
			}
			if (prefer != 'remote' && prefer != 'local') {
				return err_res('INVALID_PARAM', 'Prefer must be remote or local');
			}

			let lock = acquire_lock('save_subscription', 30);
			if (!lock.ok) return err_res('LOCKED', lock.error);

			let cur_rev = compute_config_revision();
			if (req.args?.revision && length(req.args.revision) > 0 && req.args.revision != cur_rev) {
				release_lock();
				return err_res('REVISION_CONFLICT', 'Config changed externally; reload before saving', {
					current_revision: cur_rev
				});
			}

			let uci = cursor();
			let sid = req.args?.id;
			if (sid && length(sid) > 0) {
				if (!is_valid_section_id(sid) || uci.get('nikki', sid) != 'subscription') {
					release_lock();
					return err_res('NOT_FOUND', 'Subscription section not found');
				}
			} else {
				sid = uci.add('nikki', 'subscription');
			}

			uci.set('nikki', sid, 'name', name);
			uci.set('nikki', sid, 'url', url);
			if (length(info_url) > 0) uci.set('nikki', sid, 'info_url', info_url);
			else uci.delete('nikki', sid, 'info_url');
			uci.set('nikki', sid, 'user_agent', ua);
			uci.set('nikki', sid, 'prefer', prefer);
			uci.commit('nikki');

			release_lock();
			return ok_res({
				id: sid,
				http_warning: substr(lc(url), 0, 7) == 'http://',
				revision: compute_config_revision()
			});
		}
	},

	delete_subscription: {
		args: { id: '', fallback_profile: '', force_stop: false },
		call: function(req) {
			let sid = req.args?.id;
			if (!is_valid_section_id(sid)) {
				return err_res('INVALID_PARAM', 'Invalid subscription ID');
			}
			let lock = acquire_lock('delete_subscription', 30);
			if (!lock.ok) return err_res('LOCKED', lock.error);

			let uci = cursor();
			if (uci.get('nikki', sid) != 'subscription') {
				release_lock();
				return err_res('NOT_FOUND', 'Subscription not found');
			}

			let active = uci.get('nikki', 'config', 'profile') ?? '';
			if (active == `subscription:${sid}`) {
				if (req.args?.fallback_profile && length(req.args.fallback_profile) > 0) {
					uci.set('nikki', 'config', 'profile', req.args.fallback_profile);
				} else if (req.args?.force_stop) {
					uci.set('nikki', 'config', 'enabled', '0');
					uci.delete('nikki', 'config', 'profile');
					uci.commit('nikki');
					exec_argv(['/etc/init.d/nikki', 'stop']);
				} else {
					release_lock();
					return err_res('ACTIVE_PROFILE_PROTECTED', 'Cannot delete active subscription without fallback profile or stopping Nikki');
				}
			}

			uci.delete('nikki', sid);
			uci.commit('nikki');

			let sub_file = `${NIKKI_SUBSCRIPTIONS_DIR}/${sid}.yaml`;
			if (lstat(sub_file)?.type == 'file') unlink(sub_file);

			release_lock();
			return ok_res({ deleted: sid, revision: compute_config_revision() });
		}
	},

	switch_profile: {
		args: { profile: '', apply: false, idempotency_key: '' },
		call: function(req) {
			let profile = trim(req.args?.profile ?? '');
			let colon = index(profile, ':');
			if (colon < 0) return err_res('INVALID_PARAM', 'Profile must be file:<name> or subscription:<id>');
			let ptype = substr(profile, 0, colon);
			let pid = substr(profile, colon + 1);

			if (ptype == 'file') {
				let rp = resolve_safe_path('profile', pid, false);
				if (!rp.ok || !rp.exists) return err_res('NOT_FOUND', 'Profile file not found');
			} else if (ptype == 'subscription') {
				if (!is_valid_section_id(pid) || cursor().get('nikki', pid) != 'subscription') {
					return err_res('NOT_FOUND', 'Subscription not found');
				}
			} else {
				return err_res('INVALID_PARAM', 'Invalid profile prefix');
			}

			if (req.args?.apply) {
				return spawn_async_task('apply_config', {
					action: 'apply',
					changes: { named: { config: { profile: profile } } }
				}, req.args?.idempotency_key);
			}

			let r = save_config_sync('', { named: { config: { profile: profile } } });
			if (!r.ok) return r;
			return ok_res({ profile: profile, revision: r.revision });
		}
	},

	fix_controller_bind: {
		args: { bind_addr: '', clear_tls_wildcard: false, apply: true, idempotency_key: '' },
		call: function(req) {
			let addr = trim(req.args?.bind_addr ?? '127.0.0.1:9090');
			if (!match(addr, /^(127\.0\.0\.1|\[::1\]):[0-9]{1,5}$/)) {
				return err_res('INVALID_PARAM', 'Controller fix address must be loopback (127.0.0.1:<port> or [::1]:<port>)');
			}
			let mixin_changes = { api_listen: addr };
			if (req.args?.clear_tls_wildcard) {
				mixin_changes.api_tls_listen = '';
			}
			if (req.args?.apply) {
				return spawn_async_task('apply_config', {
					action: 'apply',
					changes: { named: { mixin: mixin_changes } }
				}, req.args?.idempotency_key);
			}
			return save_config_sync('', { named: { mixin: mixin_changes } });
		}
	},

	/* ==================== Transactions & Async Tasks ==================== */

	apply_config: {
		args: { revision: '', changes: {}, action: '', idempotency_key: '' },
		call: function(req) {
			let act = req.args?.action ?? 'apply';
			if (act == 'save') {
				return save_config_sync(req.args?.revision, req.args?.changes);
			}
			if (act != 'apply' && act != 'test') {
				return err_res('INVALID_PARAM', 'Action must be save, test, or apply');
			}
			return spawn_async_task('apply_config', {
				revision: req.args?.revision ?? '',
				changes: req.args?.changes ?? {},
				action: act
			}, req.args?.idempotency_key);
		}
	},

	service_action: {
		args: { action: '', idempotency_key: '' },
		call: function(req) {
			let act = req.args?.action;
			let allowed = ['start', 'stop', 'restart', 'reload', 'enable', 'disable'];
			if (index(allowed, act) < 0) {
				return err_res('INVALID_PARAM', `Unsupported service action: ${act}`);
			}
			return spawn_async_task('service_action', { action: act }, req.args?.idempotency_key);
		}
	},

	update_subscription: {
		args: { section_id: '', reload_if_active: true, idempotency_key: '' },
		call: function(req) {
			let sid = req.args?.section_id;
			if (!is_valid_section_id(sid)) {
				return err_res('INVALID_PARAM', 'Invalid subscription section_id');
			}
			if (cursor().get('nikki', sid) != 'subscription') {
				return err_res('NOT_FOUND', 'Subscription not found');
			}
			return spawn_async_task('update_subscription', {
				section_id: sid,
				reload_if_active: req.args?.reload_if_active != false
			}, req.args?.idempotency_key);
		}
	},

	get_task: {
		args: { task_id: '' },
		call: function(req) {
			return read_task_state(req.args?.task_id);
		}
	},

	list_tasks: {
		args: { limit: 0 },
		call: function(req) {
			return list_recent_tasks(req.args?.limit);
		}
	},

	/* ==================== Integrated Nikki Core Management ==================== */

	get_core_status: {
		call: function() {
			return ok_res({ platform: detect_platform() });
		}
	},

	install_core: {
		args: { core_variant: '', idempotency_key: '' },
		call: function(req) {
			let variant = req.args?.core_variant ?? 'meta';
			if (variant == '') variant = 'meta';
			if (variant != 'meta' && variant != 'alpha') {
				return err_res('INVALID_PARAM', 'core_variant must be meta or alpha');
			}
			return spawn_async_task('install_core', { core_variant: variant }, req.args?.idempotency_key);
		}
	},

	remove_luci_nikki: {
		args: { idempotency_key: '' },
		call: function(req) {
			return spawn_async_task('remove_luci_nikki', {}, req.args?.idempotency_key);
		}
	},

	/* ==================== Panel Access & Settings ==================== */

	get_access: {
		call: function() {
			return ok_res({ access: get_access_config(ubus) });
		}
	},

	set_access: {
		args: {
			access_mode: '',
			http_port: 0,
			https_port: 0,
			listen_interfaces: [],
			cert: '',
			key: '',
			session_timeout: 0,
			confirm_wan_risk: false,
			generate_self_signed: false,
			theme: '',
			lang: ''
		},
		call: function(req) {
			let caller = get_caller_session(ubus, req);
			return set_access_config(ubus, caller, req.args ?? {});
		}
	}
};

return { 'nikki-dash': methods };
