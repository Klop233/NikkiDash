	/* Unauthenticated safe pre-login metadata */
	auth_info: {
		call: function() {
			let uci = cursor();
			let mode = uci.get('nikki_dash', 'main', 'access_mode') ?? 'lan_auth';
			let rpcd_guest = cursor().get('rpcd', 'nikki_dash_guest') != null;
			return {
				version: DASH_VERSION,
				title: 'NikkiDash',
				access_mode: mode,
				lan_guest_enabled: (mode == 'lan_guest' && rpcd_guest),
				default_theme: uci.get('nikki_dash', 'main', 'theme') ?? 'system',
				default_lang: uci.get('nikki_dash', 'main', 'lang') ?? 'zh-CN',
				wan_warning: mode == 'wan_https'
			};
		}
	},

	capabilities: {
		call: function(req) {
			let caller = get_caller_session(ubus, req);
			return get_capabilities(ubus, caller);
		}
	},

	get_status: {
		call: function() {
			let uci = cursor();
			let svc = get_nikki_service_state();
			let ctrl = resolve_controller();
			let ctrl_pub = controller_public_info(ctrl);

			let ctrl_reachable = false;
			let ctrl_error = null;
			let core_version = '';
			let runtime_mode = uci.get('nikki', 'mixin', 'mode') ?? 'rule';

			if (svc.running && ctrl.configured) {
				let vr = api_version(ctrl);
				if (vr.ok) {
					ctrl_reachable = true;
					core_version = vr.data?.version ?? '';
					let cr = api_get_configs(ctrl);
					if (cr.ok && cr.data?.mode) runtime_mode = cr.data.mode;
				} else {
					ctrl_error = vr.error;
				}
			}

			let recent = list_recent_tasks(5);
			let active_tasks = filter(recent.tasks ?? [], (t) => t.status == 'queued' || t.status == 'running');

			let tun_device = uci.get('nikki', 'mixin', 'tun_device') ?? 'nikki';
			let tun_up = false;
			if (svc.running && cmd_exists('ip')) {
				let tr = exec_argv(['ip', 'link', 'show', 'dev', tun_device]);
				if (tr.code == 0 && index(tr.stdout, 'UP') >= 0) tun_up = true;
			}

			return ok_res({
				running: svc.running,
				pid: svc.pid,
				uptime: svc.uptime,
				enabled: uci.get('nikki', 'config', 'enabled') == '1',
				profile: uci.get('nikki', 'config', 'profile') ?? '',
				core_only: uci.get('nikki', 'config', 'core_only') == '1',
				proxy_enabled: uci.get('nikki', 'proxy', 'enabled') == '1',
				tcp_mode: uci.get('nikki', 'proxy', 'tcp_mode') ?? '',
				udp_mode: uci.get('nikki', 'proxy', 'udp_mode') ?? '',
				dns_mode: uci.get('nikki', 'mixin', 'dns_mode') ?? '',
				mode: runtime_mode,
				core_version: core_version,
				dash_version: DASH_VERSION,
				revision: compute_config_revision(),
				controller: {
					...ctrl_pub,
					reachable: ctrl_reachable,
					error: ctrl_error
				},
				health: {
					controller_ok: ctrl_reachable,
					nft_hijack_ok: svc.nft_hijack_ok,
					tun_up: tun_up,
					conflicts: detect_conflicts(ubus)
				},
				active_tasks: active_tasks
			});
		}
	},

	get_overview_metrics: {
		call: function() {
			let ctrl = resolve_controller();
			if (!ctrl.configured) {
				return err_res('CONTROLLER_UNCONFIGURED', 'Controller not configured');
			}
			let conns = api_get_connections();
			if (!conns.ok) return conns;

			let cfgs = api_get_configs(ctrl);
			let proxies = api_get_proxies();

			let list = conns.data?.connections ?? [];
			let groups = [];
			if (proxies.ok && type(proxies.data?.proxies) == 'object') {
				let pmap = proxies.data.proxies;
				for (let gname in pmap) {
					let p = pmap[gname];
					if (p && type(p.all) == 'array' && gname != 'GLOBAL') {
						push(groups, {
							name: gname,
							type: p.type ?? '',
							now: p.now ?? '',
							count: length(p.all)
						});
					}
				}
			}

			return ok_res({
				mode: cfgs.ok ? (cfgs.data?.mode ?? 'rule') : 'rule',
				upload_total: conns.data?.uploadTotal ?? 0,
				download_total: conns.data?.downloadTotal ?? 0,
				memory: conns.data?.memory ?? 0,
				connection_count: length(list),
				groups: slice(groups, 0, 12),
				timestamp: time()
			});
		}
	},

	get_config: {
		call: function() {
			let cfg = read_nikki_config(false);
			return ok_res({
				...cfg,
				revision: compute_config_revision(),
				schema: load_schema(),
				identifiers: get_system_identifiers(ubus)
			});
		}
	},

	get_profiles: {
		call: function() {
			let uci = cursor();
			let active = uci.get('nikki', 'config', 'profile') ?? '';
			let all = uci.get_all('nikki') ?? {};

			let subs = [];
			for (let sid in all) {
				let sec = all[sid];
				if (sec?.['.type'] != 'subscription') continue;
				let fpath = `${NIKKI_SUBSCRIPTIONS_DIR}/${sid}.yaml`;
				let st = lstat(fpath);
				push(subs, {
					id: sid,
					name: sec.name ?? sid,
					url: sec.url ?? '',
					info_url: sec.info_url ?? '',
					user_agent: sec.user_agent ?? 'clash',
					prefer: sec.prefer ?? 'remote',
					expire: sec.expire ?? '',
					upload: sec.upload ?? '',
					download: sec.download ?? '',
					total: sec.total ?? '',
					used: sec.used ?? '',
					avaliable: sec.avaliable ?? '',
					update: sec.update ?? '',
					success: sec.success ?? '',
					file_exists: st != null && st.type == 'file',
					file_size: st?.size ?? 0,
					active: active == `subscription:${sid}`,
					index: sec['.index'] ?? 9999
				});
			}
			sort(subs, (a, b) => a.index - b.index);

			let files = [];
			let entries = lsdir(NIKKI_PROFILES_DIR) ?? [];
			sort(entries);
			for (let e in entries) {
				if (!is_valid_basename(e) || !match(e, /\.(ya?ml)$/i)) continue;
				let st = lstat(`${NIKKI_PROFILES_DIR}/${e}`);
				if (!st || st.type != 'file') continue;
				push(files, {
					name: e,
					size: st.size,
					mtime: st.mtime,
					active: active == `file:${e}`
				});
			}

			return ok_res({
				active_profile: active,
				subscriptions: subs,
				files: files,
				revision: compute_config_revision()
			});
		}
	},

