const ubus = connect();

function get_nikki_service_state() {
	let svc = ubus.call('service', 'list', { name: 'nikki' });
	let inst = svc?.nikki?.instances?.nikki;
	let running = inst?.running == true;
	let pid = inst?.pid ?? null;

	let uptime = 0;
	if (running && pid) {
		let pst = lstat(`/proc/${pid}`);
		if (pst && pst.ctime) {
			let d = time() - pst.ctime;
			uptime = d > 0 ? d : 0;
		}
	}

	let nft_ok = false;
	if (running && cmd_exists('nft')) {
		let r = exec_argv(['nft', 'list', 'tables']);
		if (r.code == 0 && index(r.stdout, 'nikki') >= 0) nft_ok = true;
	}

	return {
		running: running,
		pid: pid,
		uptime: uptime,
		started_flag: lstat(NIKKI_STARTED_FLAG) != null,
		nft_hijack_ok: nft_ok
	};
}

