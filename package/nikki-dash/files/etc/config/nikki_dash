config main 'main'
	option enabled '1'
	option access_mode 'lan_auth'
	option http_port '18080'
	option https_port '18443'
	list listen_interface 'lan'
	option cert '/etc/nikki-dash/server.crt'
	option key '/etc/nikki-dash/server.key'
	option session_timeout '3600'
	option max_requests '6'
	option max_connections '64'
	option script_timeout '30'
	option network_timeout '30'
	option wan_risk_acknowledged '0'
	option theme 'system'
	option lang 'zh-CN'
